# SafePulse AI Environment Configuration
# Copy to .env and replace secrets before deploying. Never commit .env files.

APP_NAME=SafePulse AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./safepulse.db

# Generate a strong random secret in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-in-production-use-64-char-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (requests per window)
RATE_LIMIT_PER_MINUTE=60

# Optional external threat reputation APIs (app runs fully offline/locally without these)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

